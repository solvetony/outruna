{
  "name": "outruna-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "node scripts/write-version.cjs && vite build --minify false --logLevel warn && node scripts/create-dist-manifest.cjs && bash scripts/sign-dist-manifest.sh && bash scripts/verify-dist.sh",
    "verify": "bash scripts/verify-dist.sh",
    "test": "node --test test/*.test.js",
    "test:visual": "playwright test",
    "test:visual:login": "RUN_LIVE_EMAIL=1 playwright test login.spec.js --project=mobile",
    "test:visual:compare": "VISUAL_COMPARE=1 playwright test",
    "test:visual:update": "VISUAL_COMPARE=1 playwright test --update-snapshots"
  },
  "dependencies": {
    "@chironbuilder/tari-l1-wasm": "5.6.0-pre.7",
    "@noble/hashes": "2.4.0",
    "@preact/preset-vite": "^2.10.2",
    "@privy-io/react-auth": "^3.35.1",
    "@rabby-wallet/rabby-sign": "^0.4.1",
    "decimal.js": "^10.6.0",
    "lucide-preact": "^0.468.0",
    "preact": "^10.25.3",
    "preact-i18n": "^2.4.0-preactx",
    "qrcode-generator": "^2.0.4",
    "vite": "^6.0.7",
    "vite-plugin-wasm": "3.6.0"
  },
  "overrides": {
    "axios": "1.18.0",
    "postcss": "8.5.28",
    "@wagmi/connectors": {
      "@walletconnect/utils": "2.21.9"
    },
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "fake-indexeddb": "6.2.5"
  }
}
